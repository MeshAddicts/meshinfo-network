---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MeshInfo Network',
  description = 'A centralized directory for MeshInfo instances — discover Meshtastic mesh networks near you.',
} = Astro.props;

const siteName = 'MeshInfo Network';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen bg-surface font-sans text-gray-100 antialiased">
    <!-- Navigation -->
    <header class="sticky top-0 z-50 border-b border-surface-border bg-surface/80 backdrop-blur-md">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <nav class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2 text-white no-underline hover:text-white">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-brand-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"
              />
            </svg>
            <span class="font-semibold tracking-tight">MeshInfo Network</span>
          </a>

          <div class="flex items-center gap-6 text-sm">
            <a href="/" class="text-gray-400 hover:text-gray-200 no-underline transition-colors">
              Home
            </a>
            <a
              href="/instances"
              class="text-gray-400 hover:text-gray-200 no-underline transition-colors"
            >
              Instances
            </a>
            <a
              href="https://github.com/MeshAddicts/meshinfo-network"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-gray-200 no-underline transition-colors"
            >
              GitHub
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-24 border-t border-surface-border">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
          <p class="text-sm text-gray-500">
            &copy; {new Date().getFullYear()} MeshAddicts. Open source under the MIT License.
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-500">
            <a
              href="https://github.com/MeshAddicts/meshinfo-network"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gray-300 no-underline transition-colors"
            >
              GitHub
            </a>
            <a
              href="https://github.com/MeshAddicts/meshinfo"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gray-300 no-underline transition-colors"
            >
              MeshInfo
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
