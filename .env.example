# ─── Strapi secrets ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe

# ─── Internal API token ───────────────────────────────────────────────────────
# Token used by Astro to call the internal Strapi API.
# Create this token in the Strapi admin under Settings → API Tokens.
STRAPI_TOKEN=your-strapi-api-token-here
